{
  "name": "cloudflare-ssh-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run --config wrangler.example.jsonc",
    "deploy": "wrangler deploy --config wrangler.local.jsonc",
    "secret:ssh": "wrangler secret put SSH_PRIVATE_KEY --config wrangler.local.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@workeryard/undershell": "0.2.0",
    "agents": "0.30.1",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "typescript": "6.0.3",
    "wrangler": "4.151.2"
  },
  "description": "A self-hosted SSH MCP server built on Cloudflare Workers, Managed OAuth, VPC and Tunnel."
}
