// Copy to wrangler.local.jsonc and fill in your own values.
// Empty OWNER_EMAIL / ACCESS_AUD deny every MCP request until configured.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ssh-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://cloudflare-ssh-mcp.YOUR-SUBDOMAIN.workers.dev",
    "ACCESS_TEAM_DOMAIN": "YOUR-TEAM.cloudflareaccess.com",
    "OWNER_EMAIL": "",
    "SSH_USER": "YOUR_WINDOWS_USER",
    "SSH_HOST_KEY": "SHA256:REPLACE_WITH_VERIFIED_HOST_FINGERPRINT",
    "ACCESS_AUD": ""
  },
  "vpc_networks": [
    {
      "binding": "SSH_VPC",
      "tunnel_id": "00000000-0000-0000-0000-000000000000",
      "remote": true
    }
  ]
}
